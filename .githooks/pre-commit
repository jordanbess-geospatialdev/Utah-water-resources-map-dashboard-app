#!/bin/sh
# pre-commit — lightweight secret scan of the staged diff (CI runs the full version).
diff=$(git diff --cached --diff-filter=ACMR -U0 -- . ':!pnpm-lock.yaml')
echo "$diff" | grep -nE "(AKIA[0-9A-Z]{16}|BEGIN (RSA|EC|OPENSSH|PGP) PRIVATE KEY|xox[baprs]-[0-9A-Za-z]{10,}|AIza[0-9A-Za-z_-]{35}|password[[:space:]]*[:=][[:space:]]*[\"'][^\"']{8})" >/dev/null 2>&1 && {
  echo "pre-commit: secret-like pattern in staged changes; resolve before committing" >&2
  exit 1
}
exit 0
