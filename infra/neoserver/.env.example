# WD-005 NeoServer qualification stack - SECRETS ONLY.
#
# Copy to infra/neoserver/.env (gitignored). Every value here is a SECRET
# REFERENCE holder: replace the placeholders, never commit the filled copy,
# never paste these values into issues, logs or agent prompts.
#
#   cp infra/neoserver/.env.example infra/neoserver/.env

# Encryption key for NeoServer's catalog store (volume `serverdata`).
# Generate: openssl rand -hex 32
# Cannot be rotated in place; losing it means re-initializing the store.
NEOSRV_STORE_KEY=replace-with-openssl-rand-hex-32

# Password of the disposable qualification PostGIS instance.
# Generate: openssl rand -hex 16
QUALIFICATION_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16

# Value of the stored NeoServer API key issued to the qualification VIEWER
# role (read-only). capture.mjs reads it from the environment variable named
# NEOSERVER_QUALIFICATION_API_KEY; the manifest records the header NAME only.
NEOSERVER_QUALIFICATION_API_KEY=replace-with-the-viewer-stored-api-key-value
